# Copy to .env.local for development. Every one of these also has to be set in
# the Vercel project settings, or the deployed site gets the same variable
# missing and fails in exactly the same way.

# --- Supabase -------------------------------------------------------------
# Supabase -> Project Settings -> API

# Safe in the browser and in a public repo: row level security decides what it
# can see, and it can only read the rows marked published.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses row level security completely. Server-side only — it has no
# NEXT_PUBLIC_ prefix so a stray import into a client component fails the
# build rather than shipping the key to visitors. Never commit it.
# Used for creating committee accounts, and by `npm run seed`.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site -----------------------------------------------------------------

# Where the dashboard lives: https://<site>/<this>
# CHANGE THIS before deploying, and change it again whenever the committee
# hands over. It is not the security boundary — every write is behind a login
# and row level security — but an unguessable path keeps the panel out of
# crawlers and wordlists. Deliberately absent from robots.txt: listing it
# there would publish it.
NEXT_PUBLIC_ADMIN_PATH=admin

# Optional, and best left empty. It only sets the domain the social card
# images are served from, and on Vercel the deploy already knows its own
# *.vercel.app address. Fill this in only if the club ever gets a domain of
# its own, e.g. https://stratosphere.ju.ac.in
NEXT_PUBLIC_SITE_URL=

# Required for the contact form. Get a free key at https://web3forms.com using
# the club inbox address. Without it, every submission fails.
NEXT_PUBLIC_WEB3FORMS_KEY=

# --- First admin (used once by `npm run seed`) ----------------------------
# After the first run, change the password from the dashboard and clear
# ADMIN_PASSWORD out of this file. Every account after this one is created
# from the Accounts tab, not from here.
ADMIN_NAME=Club Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
