# Required. Get a free key at https://web3forms.com using the club inbox address.
# Must also be set in the Vercel project settings, or the deployed form has no key.
VITE_WEB3FORMS_KEY=

# Where the content API lives. Leave empty for local dev (Vite proxies /api to
# the backend). In production set it to the deployed API, e.g.
# https://stratosphere-api.onrender.com
VITE_API_BASE=

# The URL of the admin dashboard: https://<site>/<this>
# CHANGE THIS before deploying, and change it again whenever the committee
# hands over. It is not the security boundary — every write is behind a login —
# but an unguessable path keeps the panel out of crawlers and wordlists.
# Deliberately absent from robots.txt: listing it there would publish it.
VITE_ADMIN_PATH=control-tower
