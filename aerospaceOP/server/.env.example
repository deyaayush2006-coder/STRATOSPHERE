# MongoDB connection string.
# Atlas: mongodb+srv://<user>:<password>@<cluster>/stratosphere?retryWrites=true&w=majority
# Local: mongodb://127.0.0.1:27017/stratosphere
MONGODB_URI=

# Port the API listens on
PORT=4000

# Browser origins allowed to POST feedback, comma separated.
# Set this to the deployed site origin in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
