# --- Server ---
PORT=5000

# Comma-separated list of browser origins allowed to call this API.
# In production this is the deployed site, e.g. https://stratosphere-weld.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
# Optional: override the DNS resolvers used for Atlas SRV lookups.
# Needed where the local/ISP resolver refuses SRV queries.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Short by design: the dashboard token lives in sessionStorage and the panel
# is only used in bursts. Raise it if signing in every session gets annoying.
JWT_EXPIRES_IN=12h

# --- First admin (used once by `npm run seed`) ---
# After the first run, change the password from the dashboard and clear
# ADMIN_PASSWORD out of this file. Every account after this one is created
# from the Accounts tab, not from here.
ADMIN_NAME=Club Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
